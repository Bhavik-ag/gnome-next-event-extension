<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.next_event" path="/org/gnome/shell/extensions/next_event/">
    <key name="panel-position" type="s">
      <default>'center'</default>
    </key>

    <key name="font-size" type="i">
      <default>15</default>
      <range min="10" max="40"/>
    </key>

    <key name="max-title-length" type="i">
      <default>35</default>
      <range min="10" max="120"/>
    </key>

    <key name="refresh-interval-seconds" type="i">
      <default>60</default>
      <range min="10" max="900"/>
    </key>

    <key name="display-mode" type="s">
      <default>'next-event'</default>
    </key>

    <key name="show-mini-timeline" type="b">
      <default>true</default>
    </key>

    <key name="show-pill-background" type="b">
      <default>true</default>
    </key>

    <key name="flash-minutes-before" type="i">
      <default>5</default>
      <range min="0" max="60"/>
    </key>

    <key name="flash-minutes-after" type="i">
      <default>5</default>
      <range min="0" max="60"/>
    </key>

    <key name="skipped-events" type="as">
      <default>[]</default>
    </key>
  </schema>
</schemalist>
